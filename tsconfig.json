{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "allowJs": false,
    "outDir": "app/js",
    "rootDir": "app/ts",
    "strict": true,
    "sourceMap": true,
    "noEmit": false
  },
  "include": ["app/ts/**/*.ts", "app/ts/**/*.d.ts"]
}
